# Google Drive folder that holds the photos. Keep it private; startup fails if it has link sharing on.
GOOGLE_DRIVE_FOLDER_ID=

# Credentials: use ONE of these. See README for which applies to you.
# a) OAuth refresh token for a dedicated event Google account (works with personal accounts)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# b) Service account key; the folder must be in a Shared Drive (service accounts have no storage quota)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/key.json

# Comma-separated email=hash pairs. Generate each with: npm run hash-password -- you@example.org
ORGANIZERS=

# NODE_ENV=production marks session cookies Secure (HTTPS required) and refuses STORAGE_DRIVER=local.
NODE_ENV=production

# Optional
# PORT=3000
# DATABASE_PATH=data/photo-wall.db
# PUBLIC_ORIGIN=https://photos.example.org   # needed only if your proxy rewrites the Host header
# TRUST_PROXY=1                              # number of reverse proxies in front of the app
# UPLOAD_RATE_LIMIT_PER_MINUTE=60            # per IP; keep generous, venue wifi shares one IP
# STORAGE_DRIVER=local                       # development only, saves to data/photos
